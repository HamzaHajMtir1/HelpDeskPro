# Keep the build context small and never ship secrets into an image layer.
target
uploads
.env
.env.*
!.env.example
application-local.properties
application-secrets.properties
application-prod-local.properties
*.pem
*.key
*.p12
*.jks
.git
.gitignore
.github
.vscode
.idea
*.iml
HELP.md
README.md
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml
