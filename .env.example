# =============================================================================
# HelpDeskPro — LOCAL development environment template
# =============================================================================
# Copy, then fill in real values:
#     cp .env.example .env                  # Linux / macOS / Git Bash
#     Copy-Item .env.example .env           # Windows PowerShell
#
# .env is git-ignored. This template must contain PLACEHOLDERS ONLY.
# For production on the OVH VPS, use deploy/.env.prod.example instead.
# For CI/CD, values come from GitHub Secrets — never from a committed file.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL   (REQUIRED)
# -----------------------------------------------------------------------------
POSTGRES_DB=helpdesk_db
POSTGRES_USER=postgres

# REQUIRED. Also becomes spring.datasource.password.
# NOTE: PostgreSQL only applies this when the data volume is FIRST created.
# Changing it later requires either `docker compose down -v` (destroys data) or
#   docker exec -u postgres helpdesk-db psql -c "ALTER USER postgres WITH PASSWORD '<new>';"
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# -----------------------------------------------------------------------------
# Spring Boot   (REQUIRED)
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod

# REQUIRED. HMAC-SHA256 signing key — MUST be at least 32 characters (256 bits)
# or every login fails at token generation. Generate one with:
#     openssl rand -base64 48
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG_RANDOM

# Public URL of the frontend: CORS allow-list + links in outgoing e-mails.
FRONTEND_BASE_URL=http://localhost:3000

# Bootstrap administrator. NO default in application*.properties: if either is
# unset the application refuses to start rather than silently reinstating a
# known password. mustChangePassword=true forces rotation at first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# -----------------------------------------------------------------------------
# SMTP   (REQUIRED — host ssl0.ovh.net:587, set in application*.properties)
# -----------------------------------------------------------------------------
# Mailbox login; also used as the from-address and as admin.email.
SMTP_USER=your-mailbox@example.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD

# -----------------------------------------------------------------------------
# Groq AI   (REQUIRED — chatbot / ticket assistant)
# -----------------------------------------------------------------------------
GROQ_API_KEY=CHANGE_ME_GROQ_API_KEY

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# External Flask "agent2" service. NOT part of this repository and not in
# docker-compose.yml, so /ai/* returns 502 until you deploy it yourself.
AGENT2_URL=http://localhost:5002

# -----------------------------------------------------------------------------
# Host port bindings
# -----------------------------------------------------------------------------
# Frontend (Nginx) -> http://localhost:3000
FRONTEND_PORT=3000
# Direct API access for curl/Postman. Remove the `ports:` block in production —
# the browser only ever talks to Nginx.
BACKEND_PORT=8080

# -----------------------------------------------------------------------------
# Frontend build-time variables
# -----------------------------------------------------------------------------
# None. The React app calls the API with relative paths ("/api/..."), proxied by
# Nginx, so no VITE_* variable is baked into the bundle.
