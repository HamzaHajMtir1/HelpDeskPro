# =============================================================================
# HelpDeskPro — PRODUCTION environment template (OVH VPS)
# =============================================================================
# On the VPS:
#     cd /opt/helpdeskpro
#     cp .env.prod.example .env
#     nano .env            # fill in real values
#     chmod 600 .env       # readable only by the deploy user
#
# This file is a TEMPLATE and is committed. The real .env is NEVER committed
# and never leaves the server. CI/CD does not upload it.
# =============================================================================

# -----------------------------------------------------------------------------
# Images published by CI (GitHub Container Registry)
# -----------------------------------------------------------------------------
# The deploy workflow rewrites these to the exact commit SHA it validated.
# Pin to a SHA rather than :latest so a rollback is just editing these lines.
BACKEND_IMAGE=ghcr.io/OWNER/helpdeskpro-backend:latest
FRONTEND_IMAGE=ghcr.io/OWNER/helpdeskpro-frontend:latest

# -----------------------------------------------------------------------------
# PostgreSQL   (REQUIRED — stays private, never published to the Internet)
# -----------------------------------------------------------------------------
POSTGRES_DB=helpdesk_db
POSTGRES_USER=helpdesk

# REQUIRED. Use a long random value: openssl rand -base64 32
# NOTE: applied only when the data volume is FIRST created. To change it later:
#   docker exec -u postgres helpdeskpro-db psql -c "ALTER USER <user> WITH PASSWORD '<new>';"
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# -----------------------------------------------------------------------------
# Spring Boot   (REQUIRED)
# -----------------------------------------------------------------------------
# REQUIRED. At least 32 characters or every login fails at token generation.
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG_RANDOM

# Public HTTPS URL — CORS allow-list and links in outgoing e-mails.
# Must match the server_name in deploy/nginx/conf.d/helpdeskpro.conf.
FRONTEND_BASE_URL=https://helpdesk.4d-gile.com

# Optional JVM tuning for a small VPS, e.g. -Xmx512m
JAVA_OPTS=-XX:MaxRAMPercentage=75.0

# REQUIRED. Bootstrap administrator, used only when the account does not exist.
# No default: an unset value fails the boot loudly. Never logged.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# -----------------------------------------------------------------------------
# SMTP   (REQUIRED — host ssl0.ovh.net:587)
# -----------------------------------------------------------------------------
SMTP_USER=apps@4D-gile.com
SMTP_PASSWORD=Pfeapps2026*

# -----------------------------------------------------------------------------
# Groq AI   (REQUIRED)
# -----------------------------------------------------------------------------
GROQ_API_KEY=CHANGE_ME_GROQ_API_KEY

# -----------------------------------------------------------------------------
# Optional external Flask agent (not part of this repository)
# -----------------------------------------------------------------------------
AGENT2_URL=http://agent2:5002
