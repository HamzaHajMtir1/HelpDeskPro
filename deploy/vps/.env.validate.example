# Phase 2 ONLY — deliberately isolated from the production /opt/helpdeskpro/.env.
# Copy to .env.validate on the VPS and use with:
#   docker compose --env-file .env.validate -f docker-compose.test.yml ...
#
# Distinct DB name and JWT secret so nothing here can be mistaken for, or
# accepted by, production. SMTP stays dummy so validation cannot send real mail.
POSTGRES_DB=helpdesk_validate
POSTGRES_USER=postgres
DB_PASSWORD=REPLACE_WITH_openssl_rand_hex_24
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32_DIFFERENT_FROM_PROD
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
GROQ_API_KEY=REPLACE_OR_CHANGE_ME
FRONTEND_BASE_URL=http://localhost:8081
AGENT2_URL=http://agent2:5002

ADMIN_EMAIL=admin@validate.invalid
ADMIN_PASSWORD=REPLACE_WITH_openssl_rand_hex_24
